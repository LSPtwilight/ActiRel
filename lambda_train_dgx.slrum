description="small_elevation_big_fovy_t2"
for i in 1 2 3
do
    TIMESTAMP=$(date +"%Y-%m-%d-%H-%M-%S")
    echo "Training scan$i"
    python train.py -s data/deepblending/scan$i/ -o output/deepblending/scan${i}_${description}_${TIMESTAMP}/ --sfm_config posed --use_view_config --config_view_num 5 --select_inpaint_num 10 --use_refine_depth
    echo "Finished training scan$i"
done
echo "Finished training all scans"

