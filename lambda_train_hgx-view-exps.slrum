#!/bin/bash

#SBATCH --job-name=priorgs
#SBATCH --comment "test"
#SBATCH --nodes=1  
#SBATCH --ntasks-per-node=1             
#SBATCH --cpus-per-task=32      
#SBATCH --gres=gpu:1
#SBATCH --qos=lv0b
#SBATCH --time=7:00:00
#SBATCH --partition=HGX
#SBATCH --account=research
#SBATCH -w hgx-hyperplane09

module load cuda11.8

# set thread number to 1, avoid NUM_THREADS exceeded
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1


# replica 10views
description="small_elevation_big_fovy_t2"
for i in 1 2 3 4
# for i in 5 6 7 8
do
    TIMESTAMP=$(date +"%Y-%m-%d-%H-%M-%S")
    echo "Training scan$i"
    python train.py -s data/replica-10views/scan$i/ -o output/replica-10views/scan${i}_${description}_${TIMESTAMP}/ --sfm_config posed --use_view_config --config_view_num 10 --select_inpaint_num 10 --use_refine_depth
    echo "Finished training scan$i"
done
echo "Finished training all scans"



